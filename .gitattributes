# Scripts exécutés sous Linux (serveur LWS, GitHub Actions) : fins de ligne Unix obligatoires.
*.sh text eol=lf
*.yml text eol=lf

# Exclus de l'archive envoyée sur le serveur (git archive).
/tests export-ignore
/.github export-ignore
/PAGES* export-ignore
/requirements-dev.txt export-ignore
/ruff.toml export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
